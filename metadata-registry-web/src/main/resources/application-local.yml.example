# Copy this file to application-local.yml and customize for your local environment.
# This file is auto-imported by application.yml via `spring.config.import`.

spring:
  datasource:
    # Windows 身份验证（integratedSecurity=true）
    # 确保当前 Windows 用户已加入 metadata_registry 数据库的 db_owner 角色
    url: jdbc:sqlserver://localhost:1433;databaseName=metadata_registry;encrypt=true;trustServerCertificate=true;integratedSecurity=true

  jpa:
    hibernate:
      # Use `update` for first run to auto-create tables; switch to `validate` once schema is stable.
      ddl-auto: update
    show-sql: false

app:
  jwt:
    # Change to a long random string (at least 32 bytes) before deploying anywhere shared.
    secret: please-replace-with-a-long-random-string-of-at-least-32-bytes-XYZ
    expires-minutes: 480
  cors:
    # Comma-separated list of allowed origins. Match your front-end dev server.
    allowed-origins: http://localhost:5173
  seed:
    # Set to false if you don't want example data created on first launch.
    enabled: true
