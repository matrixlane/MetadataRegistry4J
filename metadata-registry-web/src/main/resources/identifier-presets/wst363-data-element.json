{
  "key": "wst363-data-element",
  "name": "WS/T 363 数据元标识符",
  "description": "卫生信息数据元标识符编排（WS/T 363 附录 A）：对象缩写 + 大类.小类.序号.附加码，序号按大类.小类作用域计数。示例：DE01.00.001.00",
  "template": {
    "segments": [
      {
        "type": "OBJECT_ABBREVIATION",
        "name": "objectAbbr",
        "params": {
          "mapping": { "DataElement": "DE", "ValueDomain": "VD" },
          "default": "DE"
        }
      },
      {
        "type": "VARIABLE",
        "name": "majorCategory",
        "params": { "label": "大类编码", "pattern": "\\d{2}", "required": true }
      },
      { "type": "SEPARATOR", "params": { "char": "." } },
      {
        "type": "VARIABLE",
        "name": "minorCategory",
        "params": { "label": "小类编码", "pattern": "\\d{2}", "required": true }
      },
      { "type": "SEPARATOR", "params": { "char": "." } },
      {
        "type": "SEQUENCE",
        "name": "seq",
        "params": {
          "start": 1,
          "increment": 1,
          "pad": 3,
          "scopeRefs": ["majorCategory", "minorCategory"],
          "overflow": "REJECT"
        }
      },
      { "type": "SEPARATOR", "params": { "char": "." } },
      {
        "type": "VARIABLE",
        "name": "suffixCode",
        "params": { "label": "附加码", "pattern": "\\d{2}", "default": "00", "required": false }
      }
    ]
  }
}
